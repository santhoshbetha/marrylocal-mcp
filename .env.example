# MarryLocal admin API used by the MCP server.
MARRYLOCAL_API_URL=http://localhost:4000

# Preferred: the scoped, long-lived admin token generated with:
#   mix marrylocal.gen_mcp_token admin@marrylocal.test
# The backend only accepts it on /api/v1/admin/* paths.
MARRYLOCAL_ADMIN_TOKEN=replace-with-mix-marrylocal-gen-mcp-token-output

# Fallback used only when MARRYLOCAL_ADMIN_TOKEN is empty.
# The server logs in lazily and caches the 14-day session token in memory.
MARRYLOCAL_ADMIN_EMAIL=
MARRYLOCAL_ADMIN_PASSWORD=

# Set to true to write diagnostic lines to stderr. Never write logs to stdout:
# stdout is the MCP stdio transport.
MCP_DEBUG=false
